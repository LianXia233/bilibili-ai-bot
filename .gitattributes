# 行尾规范：入库归一为 LF，检出也是 LF
# 避免 CRLF 导致 BusyBox ash / procd 等环境启动失败
* text=auto eol=lf

# 明确的文本文件
*.py   text eol=lf
*.sh   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制，不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
*.zip  binary
*.gz   binary
